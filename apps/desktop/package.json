{
  "name": "@clusteryourcodex/desktop",
  "version": "0.1.0-preview.85",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "native:check": "cargo check --locked --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
  }
}
